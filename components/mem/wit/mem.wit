package terra:mem@0.1.0;

interface host {
    record range { addr: u64, len: u64 }
    enum error { invalid, too-large, io }
    discard: func(ranges: list<range>) -> result<_, error>;
}

world device {
    import terra:host/memory@0.1.0;
    import terra:host/interrupt@0.1.0;
    import host;
    export terra:host/device-api@0.1.0;
    export terra:mmio/device@0.1.0;
}
