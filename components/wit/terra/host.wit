package terra:host@0.1.0;

/// Component-supplied IDs never select a disk, VM, interrupt line, or
/// foreign resource table.
interface memory {
    record read-range { offset: u64, len: u64 }
    record write-range { offset: u64, data: list<u8> }
    /// One bounded guest-physical copy. Offsets and lengths are checked
    /// for arithmetic overflow, mapped RAM regions, holes, and aggregate
    /// batch limits before anything is allocated or copied.
    read: func(offset: u64, len: u64) -> result<list<u8>, memory-error>;
    read-ranges: func(ranges: list<read-range>) -> result<list<u8>, memory-error>;
    write: func(offset: u64, data: list<u8>) -> result<_, memory-error>;
    /// Validate the whole bounded batch, then write in order with a release fence before each range.
    write-ranges: func(ranges: list<write-range>) -> result<_, memory-error>;
    address-limit: func() -> u64;
    enum memory-error { out-of-range, too-large, unmapped }
}

interface interrupt {
    /// Assert or deassert this device's own interrupt. No caller-chosen
    /// IRQ; the native side coalesces and rate-bounds.
    set-asserted: func(asserted: bool);
}

interface device-api {
    use terra:mmio/types@0.1.0.{device-error};
    configure: async func(readonly: bool) -> result<_, device-error>;
    run: async func() -> result<_, device-error>;
}

interface disk {
    /// One fixed-capacity disk grant per component instance. Offsets and
    /// lengths are checked natively; read-only grants reject every mutation.
    /// Sync makes prior writes durable.
    read-at: async func(offset: u64, len: u64) -> result<list<u8>, disk-error>;
    write-at: async func(offset: u64, data: list<u8>) -> result<_, disk-error>;
    discard: async func(offset: u64, len: u64) -> result<_, disk-error>;
    sync: async func() -> result<_, disk-error>;
    capacity: func() -> u64;
    enum disk-error { out-of-range, readonly, io, too-large }
}

world host-interfaces {
    import memory;
    import interrupt;
}

world block-device {
    import memory;
    import interrupt;
    import disk;
    export device-api;
    export terra:mmio/device@0.1.0;
}
