package terra:mmio@0.1.0;

interface types {
    enum device-error { unmapped, bad-len, bad-queue, not-ready, too-large, io }
    enum operation { read, write, reset, close, interrupt-level }

    record request {
        sequence: u64,
        operation: operation,
        offset: u64,
        width: u8,
        value: u64,
    }

    record reply {
        sequence: u64,
        value: u64,
        error: option<device-error>,
        interrupt: bool,
    }


    enum error {
        invalid-slot,
        overlap,
        unmapped,
        bad-width,
        overflow,
        busy,
        closed,
        device,
    }
}

interface device {
    use types.{request, reply};
    serve: async func(requests: stream<request>) -> stream<reply>;
}

world mmio-types {
    import types;
}
