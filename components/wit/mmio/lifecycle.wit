package terra:mmio@0.1.0;

interface lifecycle-platform {
    use machine-types.{device-kind};
    record device-grant { id: u32, kind: device-kind }
    variant event {
        guest-exit(s32),
        component-failed,
        vcpu-finished,
        deadline,
    }

    enum error { closed }

    next-event: async func() -> result<event, error>;
    devices: func() -> list<device-grant>;
    close-device: async func(id: u32) -> result<_, error>;
    release-interrupts: async func() -> result<_, error>;
}

interface lifecycle {
    use lifecycle-platform.{event, error};

    run: async func() -> result<event, error>;
    wait: async func() -> result<event, error>;
}
