package terra:boot@0.1.0;

interface boot {
    enum architecture { x86, arm }
    enum device-kind { block, vsock, fs, memory }

    record device {
        kind: device-kind,
        mmio-base: u64,
        irq: u32,
    }

    record machine {
        architecture: architecture,
        ram-bytes: u64,
        vcpus: u8,
        devices: list<device>,
    }

    record kernel-segment {
        source-offset: u64,
        guest-address: u64,
        file-length: u64,
        memory-length: u64,
    }

    record guest-write {
        address: u64,
        bytes: list<u8>,
    }

    record plan {
        entry: u64,
        boot-argument: u64,
        kernel-segments: list<kernel-segment>,
        writes: list<guest-write>,
    }

    enum error {
        invalid-ram,
        invalid-vcpus,
        invalid-device,
        command-line-too-long,
        invalid-kernel,
        kernel-architecture,
        kernel-layout,
        kernel-too-large,
        boot-data-too-large,
    }

    stage: func(machine: machine, kernel-prefix: list<u8>, kernel-size: u64,
                kernel-command-line: string) -> result<plan, error>;
}

world boot-component {
    export boot;
}
