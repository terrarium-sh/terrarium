{
  "name": "terrarium-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22.17" },
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "generate": "node scripts/generate-command-reference.mjs",
    "dev": "pnpm generate && vite dev",
    "build": "pnpm generate && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@alis-is/starlight": "https://codeload.github.com/alis-is/starlight/tar.gz/01ade70449543102b954160446a2658b45bc58a2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "marked": "^18.2.1",
    "sass": "^1.108.2",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
