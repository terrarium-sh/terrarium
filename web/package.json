{
  "name": "terrarium-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22.17" },
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "generate": "node scripts/generate-command-reference.mjs",
    "dev": "pnpm generate && vite dev",
    "build": "pnpm generate && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@alis-is/starlight": "https://codeload.github.com/alis-is/starlight/tar.gz/fa5483fdce64acb0b340c99e4d6cafe71654f981",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "marked": "^17.0.0",
    "sass": "^1.97.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
