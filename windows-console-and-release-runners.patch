+                std::fs::File::from_raw_handle(write_handle),
+            )
+        };
+        assert!(!input_is_ready(&reader));
+        writer.write_all(b"x").unwrap();
+        assert!(input_is_ready(&reader));
+        assert_eq!(reader.read(&mut [0]).unwrap(), 1);
+        drop(writer);
+        assert!(input_is_ready(&reader));
+        assert_eq!(reader.read(&mut [0]).unwrap(), 0);
+    }
