# terra box as a service: `systemctl start terra@pi-dev` sets up and boots the
# recipe /var/lib/terra/.terra/pi-dev.yaml as box `pi-dev`.
# Install and host setup: packaging/README.md.

[Unit]
Description=terra box (%i)
Documentation=https://github.com/terrarium-sh/terrarium
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Setup on every start re-pins an edited recipe; an unchanged one is a no-op.
# --trust-recipe is safe because no box can share ~/.terra, where the recipe lives.
ExecStartPre=/usr/local/bin/terra %S/terra/.terra/%i.yaml setup --trust-recipe
ExecStart=/usr/local/bin/terra %i --foreground

User=terra
Group=terra
SupplementaryGroups=kvm

StateDirectory=terra terra/%i
StateDirectoryMode=0700
Environment=HOME=%S/terra
# A box is keyed by its project directory, so a shared one would make every
# instance the same box.
WorkingDirectory=%S/terra/%i

TimeoutStopSec=65
Restart=on-failure
RestartSec=2

# terra confines its own workers with Bubblewrap and seccomp. Do not add
# RestrictNamespaces, SystemCallFilter or RestrictAddressFamilies: each one
# stops the VM worker or the network broker from starting.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
