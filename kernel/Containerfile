FROM docker.io/library/debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      'deb http://snapshot.debian.org/archive/debian/20261102T082611Z/ bookworm main' \
      'deb http://snapshot.debian.org/archive/debian-security/20261101T204331Z/ bookworm-security main' \
      > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends \
      bc bison cpio flex gawk gcc libelf-dev libssl-dev make perl && \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends gcc-aarch64-linux-gnu; \
    fi && \
    rm -rf /var/lib/apt/lists/*
