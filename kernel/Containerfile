FROM docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      'deb http://snapshot.debian.org/archive/debian/20260921T082148Z/ bookworm main' \
      'deb http://snapshot.debian.org/archive/debian-security/20260920T175521Z/ bookworm-security main' \
      > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends \
      bc bison cpio flex gawk gcc libelf-dev libssl-dev make perl && \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends gcc-aarch64-linux-gnu; \
    fi && \
    rm -rf /var/lib/apt/lists/*
