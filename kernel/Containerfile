FROM docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      'deb http://snapshot.debian.org/archive/debian/20261026T082512Z/ bookworm main' \
      'deb http://snapshot.debian.org/archive/debian-security/20261026T044319Z/ bookworm-security main' \
      > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends \
      bc bison cpio flex gawk gcc libelf-dev libssl-dev make perl && \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends gcc-aarch64-linux-gnu; \
    fi && \
    rm -rf /var/lib/apt/lists/*
