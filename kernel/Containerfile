FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      'deb http://snapshot.debian.org/archive/debian/20261109T083251Z/ bookworm main' \
      'deb http://snapshot.debian.org/archive/debian-security/20261109T125317Z/ bookworm-security main' \
      > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends \
      bc bison cpio flex gawk gcc libelf-dev libssl-dev make perl && \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends gcc-aarch64-linux-gnu; \
    fi && \
    rm -rf /var/lib/apt/lists/*
