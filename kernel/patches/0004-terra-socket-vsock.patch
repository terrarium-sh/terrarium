--- a/net/vmw_vsock/af_vsock.c
+++ b/net/vmw_vsock/af_vsock.c
@@ -2208,66 +2208,68 @@ static int vsock_connectible_sendmsg(struct socket *sock, struct msghdr *msg,
 static int vsock_connectible_wait_data(struct sock *sk,
 				       struct wait_queue_entry *wait,
 				       long timeout,
 				       struct vsock_transport_recv_notify_data *recv_data,
-				       size_t target)
+				       size_t target, int flags)
 {
 	const struct vsock_transport *transport;
 	struct vsock_sock *vsk;
 	s64 data;
 	int err;
 
 	vsk = vsock_sk(sk);
 	err = 0;
 	transport = vsk->transport;
 
 	while (1) {
 		prepare_to_wait(sk_sleep(sk), wait, TASK_INTERRUPTIBLE);
 		data = vsock_connectible_has_data(vsk);
+		if (data > 0 && (flags & MSG_PEEK))
+			data -= min_t(s64, data, max(sk_peek_offset(sk, flags), 0));
 		if (data != 0)
 			break;
 
 		if (sk->sk_err != 0 ||
 		    (sk->sk_shutdown & RCV_SHUTDOWN) ||
 		    (vsk->peer_shutdown & SEND_SHUTDOWN)) {
 			break;
 		}
 
 		/* Don't wait for non-blocking sockets. */
 		if (timeout == 0) {
 			err = -EAGAIN;
 			break;
 		}
 
 		if (recv_data) {
 			err = transport->notify_recv_pre_block(vsk, target, recv_data);
 			if (err < 0)
 				break;
 		}
 
 		release_sock(sk);
 		timeout = schedule_timeout(timeout);
 		lock_sock(sk);
 
 		if (signal_pending(current)) {
 			err = sock_intr_errno(timeout);
 			break;
 		} else if (timeout == 0) {
 			err = -EAGAIN;
 			break;
 		}
 	}
 
 	finish_wait(sk_sleep(sk), wait);
 
 	if (err)
 		return err;
 
 	/* Internal transport error when checking for available
 	 * data. XXX This should be changed to a connection
 	 * reset in a later change.
 	 */
 	if (data < 0)
 		return -ENOMEM;
 
 	return data;
 }
@@ -2275,78 +2277,78 @@ static int vsock_connectible_wait_data(struct sock *sk,
 static int __vsock_stream_recvmsg(struct sock *sk, struct msghdr *msg,
 				  size_t len, int flags)
 {
 	struct vsock_transport_recv_notify_data recv_data;
 	const struct vsock_transport *transport;
 	struct vsock_sock *vsk;
 	ssize_t copied;
 	size_t target;
 	long timeout;
 	int err;
 
 	DEFINE_WAIT(wait);
 
 	vsk = vsock_sk(sk);
 	transport = vsk->transport;
 
 	/* We must not copy less than target bytes into the user's buffer
 	 * before returning successfully, so we wait for the consume queue to
 	 * have that much data to consume before dequeueing.  Note that this
 	 * makes it impossible to handle cases where target is greater than the
 	 * queue size.
 	 */
 	target = sock_rcvlowat(sk, flags & MSG_WAITALL, len);
 	if (target >= transport->stream_rcvhiwat(vsk)) {
 		err = -ENOMEM;
 		goto out;
 	}
 	timeout = sock_rcvtimeo(sk, flags & MSG_DONTWAIT);
 	copied = 0;
 
 	err = transport->notify_recv_init(vsk, target, &recv_data);
 	if (err < 0)
 		goto out;
 
 
 	while (1) {
 		ssize_t read;
 
 		err = vsock_connectible_wait_data(sk, &wait, timeout,
-						  &recv_data, target);
+						  &recv_data, target, flags);
 		if (err <= 0)
 			break;
 
 		err = transport->notify_recv_pre_dequeue(vsk, target,
 							 &recv_data);
 		if (err < 0)
 			break;
 
 		read = transport->stream_dequeue(vsk, msg, len - copied, flags);
 		if (read < 0) {
 			err = read;
 			break;
 		}
 
 		copied += read;
 
 		err = transport->notify_recv_post_dequeue(vsk, target, read,
 						!(flags & MSG_PEEK), &recv_data);
 		if (err < 0)
 			goto out;
 
 		if (read >= target || flags & MSG_PEEK)
 			break;
 
 		target -= read;
 	}
 
 	if (sk->sk_err)
 		err = -sk->sk_err;
 	else if (sk->sk_shutdown & RCV_SHUTDOWN)
 		err = 0;
 
 	if (copied > 0)
 		err = copied;
 
 out:
 	return err;
 }
@@ -2354,49 +2356,49 @@ static int __vsock_stream_recvmsg(struct sock *sk, struct msghdr *msg,
 static int __vsock_seqpacket_recvmsg(struct sock *sk, struct msghdr *msg,
 				     size_t len, int flags)
 {
 	const struct vsock_transport *transport;
 	struct vsock_sock *vsk;
 	ssize_t msg_len;
 	long timeout;
 	int err = 0;
 	DEFINE_WAIT(wait);
 
 	vsk = vsock_sk(sk);
 	transport = vsk->transport;
 
 	timeout = sock_rcvtimeo(sk, flags & MSG_DONTWAIT);
 
-	err = vsock_connectible_wait_data(sk, &wait, timeout, NULL, 0);
+	err = vsock_connectible_wait_data(sk, &wait, timeout, NULL, 0, 0);
 	if (err <= 0)
 		goto out;
 
 	msg_len = transport->seqpacket_dequeue(vsk, msg, flags);
 
 	if (msg_len < 0) {
 		err = msg_len;
 		goto out;
 	}
 
 	if (sk->sk_err) {
 		err = -sk->sk_err;
 	} else if (sk->sk_shutdown & RCV_SHUTDOWN) {
 		err = 0;
 	} else {
 		/* User sets MSG_TRUNC, so return real length of
 		 * packet.
 		 */
 		if (flags & MSG_TRUNC)
 			err = msg_len;
 		else
 			err = len - msg_data_left(msg);
 
 		/* Always set MSG_TRUNC if real length of packet is
 		 * bigger than user's buffer.
 		 */
 		if (msg_len > len)
 			msg->msg_flags |= MSG_TRUNC;
 	}
 
 out:
 	return err;
 }
@@ -2509,25 +2511,36 @@ static int vsock_set_rcvlowat(struct sock *sk, int val)
 	return 0;
 }
 
+static int vsock_set_peek_off(struct sock *sk, int offset)
+{
+	int error;
+
+	lock_sock(sk);
+	error = sk_set_peek_off(sk, offset);
+	release_sock(sk);
+	return error;
+}
+
 static const struct proto_ops vsock_stream_ops = {
 	.family = PF_VSOCK,
 	.owner = THIS_MODULE,
 	.release = vsock_release,
 	.bind = vsock_bind,
 	.connect = vsock_connect,
 	.socketpair = sock_no_socketpair,
 	.accept = vsock_accept,
 	.getname = vsock_getname,
 	.poll = vsock_poll,
 	.ioctl = vsock_ioctl,
 	.listen = vsock_listen,
 	.shutdown = vsock_shutdown,
 	.setsockopt = vsock_connectible_setsockopt,
 	.getsockopt = vsock_connectible_getsockopt,
 	.sendmsg = vsock_connectible_sendmsg,
 	.recvmsg = vsock_connectible_recvmsg,
 	.mmap = sock_no_mmap,
 	.set_rcvlowat = vsock_set_rcvlowat,
+	.set_peek_off = vsock_set_peek_off,
 	.read_skb = vsock_read_skb,
 };
 
--- a/net/vmw_vsock/virtio_transport_common.c
+++ b/net/vmw_vsock/virtio_transport_common.c
@@ -667,48 +667,76 @@ static int virtio_transport_send_credit_update(struct vsock_sock *vsk)
 	return virtio_transport_send_pkt_info(vsk, &info);
 }
 
+int virtio_transport_send_credit_request(struct vsock_sock *vsk)
+{
+	struct virtio_vsock_pkt_info info = {
+		.op = VIRTIO_VSOCK_OP_CREDIT_REQUEST,
+		.vsk = vsk,
+	};
+	struct sock *sk = sk_vsock(vsk);
+	int error;
+
+	lock_sock(sk);
+	if (sk->sk_state != TCP_ESTABLISHED)
+		error = -ENOTCONN;
+	else
+		error = virtio_transport_send_pkt_info(vsk, &info);
+	release_sock(sk);
+	return error;
+}
+EXPORT_SYMBOL_GPL(virtio_transport_send_credit_request);
+
 static ssize_t
 virtio_transport_stream_do_peek(struct vsock_sock *vsk,
 				struct msghdr *msg,
-				size_t len)
+				size_t len, int flags)
 {
 	struct virtio_vsock_sock *vvs = vsk->trans;
 	struct sk_buff *skb;
 	size_t total = 0;
+	u32 skip = max(sk_peek_offset(sk_vsock(vsk), flags), 0);
 	int err;
 
 	spin_lock_bh(&vvs->rx_lock);
 
 	skb_queue_walk(&vvs->rx_queue, skb) {
-		size_t bytes;
+		size_t bytes, offset = VIRTIO_VSOCK_SKB_CB(skb)->offset;
 
-		bytes = min_t(size_t, len - total,
-			      skb->len - VIRTIO_VSOCK_SKB_CB(skb)->offset);
+		bytes = skb->len - offset;
+		if (skip >= bytes) {
+			skip -= bytes;
+			continue;
+		}
+		offset += skip;
+		bytes = min_t(size_t, len - total, bytes - skip);
+		skip = 0;
 
 		spin_unlock_bh(&vvs->rx_lock);
 
 		/* sk_lock is held by caller so no one else can dequeue.
 		 * Unlock rx_lock since skb_copy_datagram_iter() may sleep.
 		 */
-		err = skb_copy_datagram_iter(skb, VIRTIO_VSOCK_SKB_CB(skb)->offset,
-					     &msg->msg_iter, bytes);
-		if (err)
-			goto out;
+		if (!(flags & MSG_TRUNC)) {
+			err = skb_copy_datagram_iter(skb, offset, &msg->msg_iter, bytes);
+			if (err)
+				goto out;
+		}
 
 		total += bytes;
+		sk_peek_offset_fwd(sk_vsock(vsk), bytes);
 
 		spin_lock_bh(&vvs->rx_lock);
 
 		if (total == len)
 			break;
 	}
 
 	spin_unlock_bh(&vvs->rx_lock);
 
 	return total;
 
 out:
 	if (total)
 		err = total;
 	return err;
 }
@@ -716,82 +744,86 @@ static ssize_t
 static ssize_t
 virtio_transport_stream_do_dequeue(struct vsock_sock *vsk,
 				   struct msghdr *msg,
-				   size_t len)
+				   size_t len, int flags)
 {
 	struct virtio_vsock_sock *vvs = vsk->trans;
 	struct sk_buff *skb;
 	u32 fwd_cnt_delta;
 	bool low_rx_bytes;
 	int err = -EFAULT;
 	size_t total = 0;
-	u32 free_space;
+	u32 receive_window;
+	u32 peer_receive_window;
+	int receive_low_water;
+
+	spin_lock_bh(&vvs->tx_lock);
+	peer_receive_window = vvs->peer_buf_alloc;
+	spin_unlock_bh(&vvs->tx_lock);
 
 	spin_lock_bh(&vvs->rx_lock);
 
 	if (WARN_ONCE(skb_queue_empty(&vvs->rx_queue) && vvs->rx_bytes,
 		      "rx_queue is empty, but rx_bytes is non-zero\n")) {
 		spin_unlock_bh(&vvs->rx_lock);
 		return err;
 	}
 
 	while (total < len && !skb_queue_empty(&vvs->rx_queue)) {
 		size_t bytes, dequeued = 0;
 
 		skb = skb_peek(&vvs->rx_queue);
 
 		bytes = min_t(size_t, len - total,
 			      skb->len - VIRTIO_VSOCK_SKB_CB(skb)->offset);
 
 		/* sk_lock is held by caller so no one else can dequeue.
 		 * Unlock rx_lock since skb_copy_datagram_iter() may sleep.
 		 */
 		spin_unlock_bh(&vvs->rx_lock);
 
-		err = skb_copy_datagram_iter(skb,
-					     VIRTIO_VSOCK_SKB_CB(skb)->offset,
-					     &msg->msg_iter, bytes);
-		if (err)
-			goto out;
+		if (!(flags & MSG_TRUNC)) {
+			err = skb_copy_datagram_iter(skb,
+						     VIRTIO_VSOCK_SKB_CB(skb)->offset,
+						     &msg->msg_iter, bytes);
+			if (err)
+				goto out;
+		}
 
 		spin_lock_bh(&vvs->rx_lock);
 
 		total += bytes;
+		sk_peek_offset_bwd(sk_vsock(vsk), bytes);
 
 		VIRTIO_VSOCK_SKB_CB(skb)->offset += bytes;
 
 		if (skb->len == VIRTIO_VSOCK_SKB_CB(skb)->offset) {
 			dequeued = le32_to_cpu(virtio_vsock_hdr(skb)->len);
 			__skb_unlink(skb, &vvs->rx_queue);
 			consume_skb(skb);
 		}
 
 		virtio_transport_dec_rx_pkt(vvs, bytes, dequeued);
 	}
 
 	fwd_cnt_delta = vvs->fwd_cnt - vvs->last_fwd_cnt;
-	free_space = vvs->buf_alloc - fwd_cnt_delta;
-	low_rx_bytes = (vvs->rx_bytes <
-			sock_rcvlowat(sk_vsock(vsk), 0, INT_MAX));
+	receive_window = min(vvs->buf_alloc, peer_receive_window);
+	receive_low_water = sock_rcvlowat(sk_vsock(vsk), 0, INT_MAX);
+	low_rx_bytes = vvs->rx_bytes < receive_low_water;
 
 	spin_unlock_bh(&vvs->rx_lock);
 
-	/* To reduce the number of credit update messages,
-	 * don't update credits as long as lots of space is available.
-	 * Note: the limit chosen here is arbitrary. Setting the limit
-	 * too high causes extra messages. Too low causes transmitter
-	 * stalls. As stalls are in theory more expensive than extra
-	 * messages, we set the limit to a high value. TODO: experiment
-	 * with different values. Also send credit update message when
-	 * number of bytes in rx queue is not enough to wake up reader.
+	/* The sender's window is the smaller buffer: return credit once half of it
+	 * drained, or when an SO_RCVLOWAT reader is still short of its mark.
 	 */
 	if (fwd_cnt_delta &&
-	    (free_space < VIRTIO_VSOCK_MAX_PKT_BUF_SIZE || low_rx_bytes))
+	    (fwd_cnt_delta >= max_t(u32, 1, receive_window / 2) ||
+	     (receive_low_water > 1 && low_rx_bytes)))
 		virtio_transport_send_credit_update(vsk);
 
 	return total;
 
 out:
 	if (total)
 		err = total;
 	return err;
 }
@@ -935,12 +967,12 @@ static int virtio_transport_seqpacket_do_dequeue(struct vsock_sock *vsk,
 ssize_t
 virtio_transport_stream_dequeue(struct vsock_sock *vsk,
 				struct msghdr *msg,
 				size_t len, int flags)
 {
 	if (flags & MSG_PEEK)
-		return virtio_transport_stream_do_peek(vsk, msg, len);
+		return virtio_transport_stream_do_peek(vsk, msg, len, flags);
 	else
-		return virtio_transport_stream_do_dequeue(vsk, msg, len);
+		return virtio_transport_stream_do_dequeue(vsk, msg, len, flags);
 }
 EXPORT_SYMBOL_GPL(virtio_transport_stream_dequeue);
 
@@ -1653,26 +1685,44 @@ static int
 static bool virtio_transport_space_update(struct sock *sk,
 					  struct sk_buff *skb)
 {
 	struct virtio_vsock_hdr *hdr = virtio_vsock_hdr(skb);
 	struct vsock_sock *vsk = vsock_sk(sk);
 	struct virtio_vsock_sock *vvs = vsk->trans;
 	bool space_available;
+	bool peer_buf_shrank;
+	bool send_update;
+	u16 op = le16_to_cpu(hdr->op);
 
 	/* Listener sockets are not associated with any transport, so we are
 	 * not able to take the state to see if there is space available in the
 	 * remote peer, but since they are only used to receive requests, we
 	 * can assume that there is always space available in the other peer.
 	 */
 	if (!vvs)
 		return true;
 
 	/* buf_alloc and fwd_cnt is always included in the hdr */
 	spin_lock_bh(&vvs->tx_lock);
+	peer_buf_shrank = le32_to_cpu(hdr->buf_alloc) < vvs->peer_buf_alloc;
 	vvs->peer_buf_alloc = le32_to_cpu(hdr->buf_alloc);
 	vvs->peer_fwd_cnt = le32_to_cpu(hdr->fwd_cnt);
 	space_available = virtio_transport_has_space(vvs);
 	spin_unlock_bh(&vvs->tx_lock);
+	/* A peer whose buffer shrank may have spent its smaller window on data we
+	 * already consumed; return that credit now, as no later read may trigger it.
+	 */
+	if (peer_buf_shrank && sk->sk_type == SOCK_STREAM &&
+	    sk->sk_state == TCP_ESTABLISHED &&
+	    (op == VIRTIO_VSOCK_OP_RW || op == VIRTIO_VSOCK_OP_CREDIT_UPDATE ||
+	     (op == VIRTIO_VSOCK_OP_SHUTDOWN &&
+	      !(le32_to_cpu(hdr->flags) & VIRTIO_VSOCK_SHUTDOWN_SEND)))) {
+		spin_lock_bh(&vvs->rx_lock);
+		send_update = vvs->fwd_cnt != vvs->last_fwd_cnt;
+		spin_unlock_bh(&vvs->rx_lock);
+		if (send_update)
+			virtio_transport_send_credit_update(vsk);
+	}
 	return space_available;
 }
 
