Subject: [PATCH] net: carry unrouted guest sockets over vsock

net/terra, copied from Terra's kernel overlay, wraps user TCP and UDP
sockets at creation and carries those whose destination has no guest route
over per-socket vsock streams to the host broker. It needs from upstream:

* socket.c: attach the adapter to user sockets.
* fib_trie.c, ipv6/route.c: lookup_matched, so a destination covered by an
  unusable route stays native.
* udp.c: IPv4 lookups skip dual-stack sockets connected to an IPv6 peer.
* af_vsock.c, virtio_transport_common.c: SO_PEEK_OFF and MSG_TRUNC on
  streams, an explicit credit request for whole UDP frames, and credit
  updates sized to the sender's window.
---
--- a/include/linux/virtio_vsock.h
+++ b/include/linux/virtio_vsock.h
@@ -217,6 +217,7 @@ ssize_t
 				   int flags);
 s64 virtio_transport_stream_has_data(struct vsock_sock *vsk);
 s64 virtio_transport_stream_has_space(struct vsock_sock *vsk);
+int virtio_transport_send_credit_request(struct vsock_sock *vsk);
 u32 virtio_transport_seqpacket_has_data(struct vsock_sock *vsk);
 
 ssize_t virtio_transport_unsent_bytes(struct vsock_sock *vsk);
--- a/include/net/ip6_fib.h
+++ b/include/net/ip6_fib.h
@@ -224,6 +224,8 @@ struct fib6_result {
 	struct fib6_info	*f6i;
 	u32			fib6_flags;
 	u8			fib6_type;
+	/* a route covered the flow, even an unusable one; see net/terra/route.c */
+	bool			lookup_matched;
 	struct rt6_info		*rt6;
 };
 
--- a/include/net/ip_fib.h
+++ b/include/net/ip_fib.h
@@ -178,6 +178,8 @@ struct fib_result {
 	unsigned char		scope;
 	u32			tclassid;
 	dscp_t			dscp;
+	/* a route covered the flow, even an unusable one; see net/terra/route.c */
+	bool			lookup_matched;
 	struct fib_nh_common	*nhc;
 	struct fib_info		*fi;
 	struct fib_table	*table;
--- a/net/Kconfig
+++ b/net/Kconfig
@@ -543,4 +543,13 @@ config NET_TEST
 
 	  If unsure, say N.
 
+config TERRA_TSI
+	bool "Terra external socket adapter"
+	depends on IP_MULTIPLE_TABLES && IPV6_MULTIPLE_TABLES && VIRTIO_VSOCKETS
+	help
+	  Carry user TCP and UDP sockets whose destination has no guest route
+	  over per-socket virtio-vsock streams to the Terra host broker, which
+	  makes the real connection. Destinations a guest route covers, even an
+	  unusable one, stay on the native stack.
+
 endif   # if NET
--- a/net/Makefile
+++ b/net/Makefile
@@ -80,3 +80,5 @@ obj-$(CONFIG_MPTCP)		+= mptcp/
 obj-$(CONFIG_MCTP)		+= mctp/
 obj-$(CONFIG_NET_HANDSHAKE)	+= handshake/
 obj-$(CONFIG_NET_SHAPER)	+= shaper/
+
+obj-$(CONFIG_TERRA_TSI) += terra/
--- a/net/ipv4/fib_trie.c
+++ b/net/ipv4/fib_trie.c
@@ -1560,6 +1560,7 @@ int fib_table_lookup(struct fib_table *tb, const struct flowi4 *flp,
 			continue;
 		if (fa->fa_info->fib_scope < flp->flowi4_scope)
 			continue;
+		res->lookup_matched = true;
 		fib_alias_accessed(fa);
 		err = fib_props[fa->fa_type].error;
 		if (unlikely(err < 0)) {
--- a/net/ipv4/udp.c
+++ b/net/ipv4/udp.c
@@ -365,6 +365,19 @@ int udp_v4_get_port(struct sock *sk, unsigned short snum)
 	return udp_lib_get_port(sk, snum, hash2_nulladdr);
 }
 
+/* A dual-stack socket connected to an IPv6 peer has no IPv4 peer address, so
+ * IPv4 lookups would otherwise take it for an unconnected socket.
+ */
+static bool udp4_has_ipv6_peer(const struct sock *sk)
+{
+#if IS_ENABLED(CONFIG_IPV6)
+	return sk->sk_family == PF_INET6 && sk->sk_state == TCP_ESTABLISHED &&
+		!ipv6_addr_any(&sk->sk_v6_daddr) && !ipv6_addr_v4mapped(&sk->sk_v6_daddr);
+#else
+	return false;
+#endif
+}
+
 static __always_inline int
 compute_score(struct sock *sk, const struct net *net,
 	      __be32 saddr, __be16 sport, __be32 daddr,
@@ -376,7 +389,7 @@ static __always_inline int
 
 	if (!net_eq(sock_net(sk), net) ||
 	    udp_sk(sk)->udp_port_hash != hnum ||
-	    ipv6_only_sock(sk))
+	    ipv6_only_sock(sk) || udp4_has_ipv6_peer(sk))
 		return -1;
 
 	if (sk->sk_rcv_saddr != daddr)
@@ -561,7 +574,7 @@ static struct sock *udp4_lib_lookup4(const struct net *net,
 	/* SLAB_TYPESAFE_BY_RCU not used, so we don't need to touch sk_refcnt */
 	udp_lrpa_for_each_entry_rcu(up, node, &hslot4->nulls_head) {
 		sk = (struct sock *)up;
-		if (inet_match(net, sk, acookie, ports, dif, sdif))
+		if (!udp4_has_ipv6_peer(sk) && inet_match(net, sk, acookie, ports, dif, sdif))
 			return sk;
 	}
 
@@ -746,7 +759,7 @@ struct sock *__udp4_lib_lookup(const struct net *net, __be32 saddr,
 				  udptable);
 
 done:
-	if (IS_ERR(result))
+	if (IS_ERR(result) || (result && udp4_has_ipv6_peer(result)))
 		return NULL;
 	return result;
 }
--- a/net/ipv6/route.c
+++ b/net/ipv6/route.c
@@ -2249,11 +2249,15 @@ int fib6_table_lookup(struct net *net, struct fib6_table *table, int oif,
 		      struct flowi6 *fl6, struct fib6_result *res, int strict)
 {
 	struct fib6_node *fn, *saved_fn;
+	struct fib6_info *candidate;
 
 	fn = fib6_node_lookup(&table->tb6_root, &fl6->daddr, &fl6->saddr);
 	saved_fn = fn;
 
 redo_rt6_select:
+	candidate = rcu_dereference(fn->leaf);
+	if (candidate && candidate != net->ipv6.fib6_null_entry)
+		res->lookup_matched = true;
 	rt6_select(net, fn, oif, res, strict);
 	if (res->f6i == net->ipv6.fib6_null_entry) {
 		fn = fib6_backtrack(fn, &fl6->saddr);
--- a/net/socket.c
+++ b/net/socket.c
@@ -59,6 +59,7 @@
 #include <linux/file.h>
 #include <linux/splice.h>
 #include <linux/net.h>
+#include <linux/terra_socket.h>
 #include <linux/interrupt.h>
 #include <linux/thread_info.h>
 #include <linux/rcupdate.h>
@@ -1626,6 +1627,13 @@ int __sock_create(struct net *net, int family, int type, int protocol,
 	 * module can have its refcnt decremented
 	 */
 	module_put(pf->owner);
+#ifdef CONFIG_TERRA_TSI
+	if (!kern) {
+		err = terra_tsi_attach(sock);
+		if (err)
+			goto out_sock_release;
